		(pad "2" smd roundrect (at 1.65 0 180) (size 0.9 1.2) (net "Net-(D1-A)"))
	)

	; ---------------------------------------------------------------------------
	; Board outline – 200 × 120 mm rectangle on Edge.Cuts.
	; ---------------------------------------------------------------------------
	(gr_line (start 0 0) (end 200 0) (layer "Edge.Cuts"))
	(gr_line (start 200 0) (end 200 120) (layer "Edge.Cuts"))
	(gr_line (start 200 120) (end 0 120) (layer "Edge.Cuts"))

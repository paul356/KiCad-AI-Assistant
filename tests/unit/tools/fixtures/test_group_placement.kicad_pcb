		(pad "2" smd roundrect (at 0.775 0) (size 0.9 0.95) (net "GND"))
	)

	; ---------------------------------------------------------------------------
	; D1 – B5819W Schottky diode (VBUS protection / reverse polarity).
	; Real position: at 96.52 69.85 180.0
	; Courtyard: fp_rect (-2.35,-1.15)→(2.35, 1.15) – SOD-123 package.
	; ---------------------------------------------------------------------------
	(footprint "Diode_SMD:D_SOD-123"
		(layer "F.Cu")

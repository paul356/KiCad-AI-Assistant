(kicad_pcb
	(version 20260206)
	(generator "pcbnew")
	(generator_version "10.0")
	(general
		(thickness 1.6)
		(legacy_teardrops no)
	)
	(paper "A4")
	(layers
		(0 "F.Cu" signal)
		(31 "B.Cu" signal)
		(33 "In1.Cu" signal)
		(36 "B.Courtyard" user)
		(37 "F.Courtyard" user)
		(40 "B.SilkS" user)
		(49 "F.SilkS" user)
		(44 "Edge.Cuts" user)
	)
	(net 0 "")
	(net 1 "VCC")
	(net 2 "GND")
	(net 3 "NET_A")

	# ---- R1: SMD resistor with courtyard ----
	(footprint "Resistor_SMD:R_0402_1005Metric"
		(layer "F.Cu")
		(uuid "11111111-0000-0000-0000-000000000001")
		(at 30.0 30.0 0.0)
		(property "Reference" "R1")
		(property "Value" "10k")
		(fp_line
			(start -1.05 -0.6)
			(end 1.05 -0.6)
			(layer "F.CrtYd")
			(width 0.05)
		)
		(fp_line
			(start 1.05 -0.6)
			(end 1.05 0.6)
			(layer "F.CrtYd")
			(width 0.05)
		)
		(fp_line
			(start 1.05 0.6)
			(end -1.05 0.6)
			(layer "F.CrtYd")
			(width 0.05)
		)
		(fp_line
			(start -1.05 0.6)
			(end -1.05 -0.6)
			(layer "F.CrtYd")
			(width 0.05)
		)
		(pad "1" smd rect
			(at -0.5 0.0)
			(size 0.5 0.5)
			(layers "F.Cu" "F.Paste" "F.Mask")
			(net 1 "VCC")
		)
		(pad "2" smd rect
			(at 0.5 0.0)
			(size 0.5 0.5)
			(layers "F.Cu" "F.Paste" "F.Mask")
			(net 2 "GND")
		)
	)

	# ---- C1: SMD capacitor with courtyard, vertically rotated ----
	(footprint "Capacitor_SMD:C_0402_1005Metric"
		(layer "F.Cu")
		(uuid "22222222-0000-0000-0000-000000000002")
		(at 60.0 30.0 0.0)
		(property "Reference" "C1")
		(property "Value" "100nF")
		(fp_line
			(start -0.6 -1.05)
			(end 0.6 -1.05)
			(layer "F.CrtYd")
			(width 0.05)
		)
		(fp_line
			(start 0.6 -1.05)
			(end 0.6 1.05)
			(layer "F.CrtYd")
			(width 0.05)
		)
		(fp_line
			(start 0.6 1.05)
			(end -0.6 1.05)
			(layer "F.CrtYd")
			(width 0.05)
		)
		(fp_line
			(start -0.6 1.05)
			(end -0.6 -1.05)
			(layer "F.CrtYd")
			(width 0.05)
		)
		(pad "1" smd rect
			(at 0.0 -0.5)
			(size 0.5 0.5)
			(layers "F.Cu" "F.Paste" "F.Mask")
			(net 1 "VCC")
		)
		(pad "2" smd rect
			(at 0.0 0.5)
			(size 0.5 0.5)
			(layers "F.Cu" "F.Paste" "F.Mask")
			(net 3 "NET_A")
		)
	)

	# ---- U1: a blocking obstacle in the middle of the board ----
	(footprint "Package_SO:SOIC-8_3.9x4.9mm_P1.27mm"
		(layer "F.Cu")
		(uuid "44444444-0000-0000-0000-000000000004")
		(at 45.0 30.0 0.0)
		(property "Reference" "U1")
		(property "Value" "IC1")
		(fp_line
			(start -2.0 -2.5)
			(end 2.0 -2.5)
			(layer "F.CrtYd")
			(width 0.05)
		)
		(fp_line
			(start 2.0 -2.5)
			(end 2.0 2.5)
			(layer "F.CrtYd")
			(width 0.05)
		)
		(fp_line
			(start 2.0 2.5)
			(end -2.0 2.5)
			(layer "F.CrtYd")
			(width 0.05)
		)
		(fp_line
			(start -2.0 2.5)
			(end -2.0 -2.5)
			(layer "F.CrtYd")
			(width 0.05)
		)
	)

	# ---- Existing track on F.Cu (VCC) ----
	(segment
		(start 29.5 30.0)
		(end 30.5 30.0)
		(width 0.25)
		(layer "F.Cu")
		(net 1 "VCC")
	)

	# ---- Keepout zone on F.Cu to force the router around ----
	(zone
		(net 0 "")
		(net_name "")
		(layer "F.Cu")
		(uuid "zone0001-0000-0000-0000-000000000001")
		(hatch edge 0.508)
		(keepout
			(tracks not_allowed)
			(vias not_allowed)
			(copperpour not_allowed)
			(footprints allowed)
			(text allowed)
		)
		(polygon
			(pts
				(xy 38.0 36.0)
				(xy 42.0 36.0)
				(xy 42.0 40.0)
				(xy 38.0 40.0)
			)
		)
	)
	(gr_rect
		(start 20.0 20.0)
		(end 70.0 60.0)
		(stroke
			(width 0.1)
			(type solid)
		)
		(fill none)
		(layer "Edge.Cuts")
		(uuid "edge-cuts-rect-0000")
	)

	# ---- D1: SMD pad on In1.Cu (GND) for cross-layer routing tests ----
	(footprint "Resistor_SMD:R_0402_1005Metric"
		(layer "In1.Cu")
		(uuid "55555555-0000-0000-0000-000000000005")
		(at 60.0 50.0 0.0)
		(property "Reference" "D1")
		(property "Value" "D1")
		(fp_line
			(start -1.05 -0.6)
			(end 1.05 -0.6)
			(layer "F.CrtYd")
			(width 0.05)
		)
		(fp_line
			(start 1.05 -0.6)
			(end 1.05 0.6)
			(layer "F.CrtYd")
			(width 0.05)
		)
		(fp_line
			(start 1.05 0.6)
			(end -1.05 0.6)
			(layer "F.CrtYd")
			(width 0.05)
		)
		(fp_line
			(start -1.05 0.6)
			(end -1.05 -0.6)
			(layer "F.CrtYd")
			(width 0.05)
		)
		(pad "1" smd rect
			(at -0.5 0.0)
			(size 0.5 0.5)
			(layers "In1.Cu" "B.Paste" "B.Mask")
			(net 2 "GND")
		)
		(pad "2" smd rect
			(at 0.5 0.0)
			(size 0.5 0.5)
			(layers "In1.Cu" "B.Paste" "B.Mask")
			(net 0 "")
		)
	)
)
